# Backend and scripts only. Never copy private keys into app/.env.local.
INK_RPC=https://rpc-gel-sepolia.inkonchain.com
CHAIN_ID=763373
USDC_ADDRESS=
# Absolute path OUTSIDE the repo; supplied by Kwal setup.
KWAL_CREDENTIALS=
ANA_ADDRESS=
ANA_VAULT_ADDRESS=
# Saved shopper address, never supplied by the agent.
ANA_SHIP_TO_JSON=
SERVICE_PRIVATE_KEY=
JUDGE_PRIVATE_KEY=
MAKER_PRIVATE_KEY=
MAKER2_PRIVATE_KEY=
TREASURY_ADDRESS=
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=
PAYMENTS_MODE=fake
# Canonical hash of ANA_SHIP_TO_JSON; used by signed purchase requests.
ANA_ADDRESS_HASH=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
OPENAI_JUDGE_MODEL=
REAP_API_KEY=
DEPLOYMENTS_FILE=deployments/ink-sepolia.json
# Local development only. Comma-separated origins, never a wildcard.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
