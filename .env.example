# Backend and scripts only. Never copy private keys into app/.env.local.
INK_RPC=https://rpc-gel-sepolia.inkonchain.com
CHAIN_ID=763373
USDC_ADDRESS=
# Absolute path OUTSIDE the repo. Never paste the bearer token into this tracked file.
KWAL_CREDENTIALS=~/.config/pws/agent-payment/credentials.json
# Create KWAL_CREDENTIALS with mode 600 using this shape:
# {"service_url":"https://api.sandbox.services.payward.com","token":"<KWAL_SANDBOX_TOKEN>","expires_at":<UNIX_SECONDS>}
# Create the idempotency companion at ${KWAL_CREDENTIALS}.payments.json:
# [{"payment_id":"pay_de230427f0194287b77669bbf393ef16","quote_id":"1d809e2a-6e71-4321-8b1f-fb75d74c43e2"}]
ANA_ADDRESS=
ANA_VAULT_ADDRESS=
# Saved shopper address, never supplied by the agent.
ANA_SHIP_TO_JSON=
SERVICE_PRIVATE_KEY=
JUDGE_PRIVATE_KEY=
MAKER_PRIVATE_KEY=
MAKER2_PRIVATE_KEY=
TREASURY_ADDRESS=
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=
PAYMENTS_MODE=fake
# Canonical hash of ANA_SHIP_TO_JSON; used by signed purchase requests.
ANA_ADDRESS_HASH=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
OPENAI_JUDGE_MODEL=
REAP_API_KEY=
DEPLOYMENTS_FILE=deployments/ink-sepolia.json
# Local development only. Comma-separated origins, never a wildcard.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
